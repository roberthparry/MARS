#!/bin/sh
set -eu

if [ "${MARS_ROOT:-}" ]; then
    root=$MARS_ROOT
else
    script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
    root=$(CDPATH= cd "$script_dir/.." && pwd)
fi

mars_home=${MARS_HOME:-"$HOME/.mars"}
holiday_config="$mars_home/config/holiday-db.env"
if [ -f "$holiday_config" ]; then
    # shellcheck disable=SC1090
    . "$holiday_config"
fi

cd "$root"

if [ ! -x build/release/scratch/mars_lab ]; then
    make scratch/mars_lab
fi

exec python3 tools/mars_lab.py "$@"
